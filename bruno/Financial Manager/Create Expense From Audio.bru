meta {
  name: Create Expense From Audio
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/financial-manager/wallets/{{walletId}}/expenses/audio
  body: json
  auth: none
}

body:json {
  {
    "audioBase64": "AAAA",
    "contentType": "audio/webm",
    "referenceDate": "2026-07-30"
  }
}

vars:pre-request {
  walletId: 0bc13a17-03a8-47d5-b684-64813d31d4d9
}

docs {
  Requires authenticated access_token cookie.
  audioBase64 must contain the recorded audio encoded as Base64.
  Uses the internal faster-whisper service to transcribe audio, then DeepSeek to classify and create the expense directly.
  Expected response: 201 Created.
}
