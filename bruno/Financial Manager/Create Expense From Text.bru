meta {
  name: Create Expense From Text
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/financial-manager/wallets/{{walletId}}/expenses/text
  body: json
  auth: none
}

body:json {
  {
    "text": "Gastei 80 no mercado, 35 na farmacia e parcelei um notebook em 12 vezes de 240,35",
    "referenceDate": "2026-07-30"
  }
}

vars:pre-request {
  walletId: 0bc13a17-03a8-47d5-b684-64813d31d4d9
}

docs {
  Requires authenticated access_token cookie.
  Uses DeepSeek to separate, normalize and classify up to 50 expenses.
  Creates all items atomically in internal batches of 25.
  Expected response: 201 Created with expenseCount, generatedExpenseCount, items and generatedExpenses.
}
