meta {
  name: Create Activity
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/activities
  body: json
  auth: none
}

body:json {
  {
    "calendarId": "{{calendarId}}",
    "description": "Study sessions",
    "week": 2,
    "type": "DAYS",
    "goal": "3",
    "replicateToWeeks": [3, 4, 6]
  }
}

vars:pre-request {
  calendarId: 70356d1a-d81b-4251-992b-c2897db69652
}

docs {
  Requires authenticated access_token cookie.
  For TIME activities, goal must be text like 3h 20m, 2m 4h, 45m or 2h.
  replicateToWeeks is optional and creates independent activities in future calendar weeks.
  Expected response: 201 Created with activity and replicas; all start with progress 0.
}
